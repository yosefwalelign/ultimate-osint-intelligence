# OSINT Platform Environment Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your_secret_key_here

# Database
DATABASE_URL=postgresql://osint:osint@localhost:5432/osint

# Redis
REDIS_URL=redis://localhost:6379/0

# TOR
TOR_PROXY=socks5://127.0.0.1:9050
TOR_CONTROL_PORT=9051
TOR_PASSWORD=

# Instagram Credentials (for Instagram OSINT)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
HIKERAPI_TOKEN=

# Google Authentication (for Google OSINT)
GOOGLE_COOKIES_PATH=/path/to/cookies.json

# API Keys
HUDSON_ROCK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
GROQ_API_KEY=

# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2

# Proxy Configuration
PROXY_LIST_FILE=/path/to/proxies.txt
PROXY_ENABLED=false
PROXY_TYPE=http

# Server Configuration
PORT=8000
HOST=0.0.0.0
WORKERS=4
TIMEOUT=120

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/osint.log

# Security
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Data Retention
RETENTION_DAYS=30
MEDIA_MAX_SIZE=10737418240

# Features
ENABLE_DARKWEB=false
ENABLE_BATCH_PROCESSING=true
ENABLE_ACTIVITY_ANALYSIS=true
